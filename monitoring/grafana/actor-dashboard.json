{
  "title": "Actors",
  "uid": "actor-spring-boot-starter",
  "tags": [
    "actors",
    "pekko"
  ],
  "description": "Actor meters of actor-spring-boot-starter (actor-metrics): messages, mailboxes, dispatchers, cluster and sharding.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(actor_dispatcher_threads, instance)",
          "refId": "instance"
        },
        "definition": "label_values(actor_dispatcher_threads, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {}
      },
      {
        "name": "system",
        "label": "Actor system",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(actor_dispatcher_threads{instance=~\"$instance\"}, system)",
          "refId": "system"
        },
        "definition": "label_values(actor_dispatcher_threads{instance=~\"$instance\"}, system)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Messages",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages processed per second",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (rate(actor_message_processed_total{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Message failures per second",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Messages whose processing threw",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (rate(actor_message_failures_total{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average processing time",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (rate(actor_message_processing_time_seconds_sum{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval])) / sum by (actor_class) (rate(actor_message_processing_time_seconds_count{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Longest processing time",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (actor_class) (actor_message_processing_time_seconds_max{system=~\"$system\", instance=~\"$instance\"})",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Mailboxes and actors",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages waiting in mailboxes",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (actor_mailbox_size{system=~\"$system\", instance=~\"$instance\"})",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average time in mailbox",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (rate(actor_mailbox_time_seconds_sum{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval])) / sum by (actor_class) (rate(actor_mailbox_time_seconds_count{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Running actors",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (actor_lifecycle_active{system=~\"$system\", instance=~\"$instance\"})",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Restarts",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (actor_class) (increase(actor_lifecycle_restarts_total{system=~\"$system\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{actor_class}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Dispatchers",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pool threads",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (dispatcher) (actor_dispatcher_threads{system=~\"$system\", instance=~\"$instance\"})",
          "legendFormat": "{{dispatcher}} threads"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (dispatcher) (actor_dispatcher_threads_active{system=~\"$system\", instance=~\"$instance\"})",
          "legendFormat": "{{dispatcher}} active"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tasks waiting for a thread",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (dispatcher) (actor_dispatcher_queued{system=~\"$system\", instance=~\"$instance\"})",
          "legendFormat": "{{dispatcher}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cluster",
      "id": 14,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Members",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max(actor_cluster_members{instance=~\"$instance\"})",
          "legendFormat": "members"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Unreachable",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max(actor_cluster_unreachable{instance=~\"$instance\"})",
          "legendFormat": "unreachable"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Leader",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The node that leads the cluster",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (instance) (actor_cluster_leader{instance=~\"$instance\"}) == 1",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Singleton host",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The node that runs the cluster singletons",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (instance) (actor_cluster_singleton_host{instance=~\"$instance\"}) == 1",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Members by node",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Each node's view; the lines differ while the cluster disagrees",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "actor_cluster_members{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} sees"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "actor_cluster_unreachable{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} unreachable"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cluster events",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (event) (increase(actor_cluster_events_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Sharding",
      "id": 21,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
